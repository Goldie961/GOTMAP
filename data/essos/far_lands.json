  {
    "id": "saffron_straits",
    "name": "Saffron Straits",
    "type": "landmark",
    "continent": "essos",
    "region": "far_lands",
    "canon_status": "inferred",
    "source": "https://awoiaf.westeros.org/index.php/Saffron_Straits",
