      "strait",
      "landmark",
      "waterway"
    ],
    "ownership_history": [],
    "metadata": {
      "type": "landmark",
      "description": "The passage of water separating the Shadow Lands from the northern coast of Ulthos. It is considered the easternmost boundary of the known world.",
      "narratorText": "The Saffron Straits connect the Jade Sea to the unknown waters of the far east. To cross the straits is to leave the known world behind. Only the most daring spice merchants sail these dark passages, seeking the secrets of Asshai."
    }
  },
