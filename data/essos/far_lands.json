    ],
    "ownership_history": [
      {
        "year": -8000,
        "house": null,
        "faction": "pearl_emperor_era",
        "lord": "Unknown Garrison Commander",
        "status": "intact",
        "event": "According to legends, the Five Forts were built by the Pearl Emperor of the Great Empire of the Dawn to guard against demons emerging from the Grey Waste.",
        "canon": "unknown",
        "source": "https://awoiaf.westeros.org/index.php/Five_Forts"
      }
    ],
    "metadata": {
      "type": "landmark",
      "description": "A line of five colossal forts built of single blocks of fused black stone, situated between the Bleeding Sea and the Mountains of the Morn. Each fort is capable of housing ten thousand men.",
      "narratorText": "Older than the Golden Empire itself, the Five Forts tower a thousand feet high. They are built of fused black stone, a craft lost to the ages. Scribes say they were built to keep out the demons of the cold wastes — and whatever was feared back then was vast indeed."
    }
  },
  {
    "id": "asshai",
    "name": "Asshai-by-the-Shadow",
    "type": "city",
    "continent": "essos",
    "region": "far_lands",
    "canon_status": "inferred",
    "source": "https://awoiaf.westeros.org/index.php/Asshai",
    "tags": [
      "city",
      "magic",
      "shadow_lands"
    ],
    "ownership_history": [
      {
        "year": -5000,
        "house": null,
        "faction": "shadowbinders",
        "lord": "None (Anarchy/Mages)",
        "status": "intact",
        "event": "Asshai stands at the end of the known world, built of oily black stone. No one knows who built it. No children live here, and no animals can survive its waters.",
        "canon": "unknown",
        "source": "https://awoiaf.westeros.org/index.php/Asshai"
      }
    ],
    "metadata": {
      "type": "city",
      "description": "A vast, dark city built entirely of oily black stone that absorbs light. Situated at the mouth of the Ash River in the Shadow Lands, it is the center of the world's dark magical arts.",
      "notable_features": [
        "Ash River",
        "Shadowbinders",
        "Oily black stone",
        "Jade Sea gate"
      ],
      "narratorText": "Asshai-by-the-Shadow is a city of silence. Its streets are vast, yet people walk them masked and alone. No child is ever born in Asshai, and no beast will drink the oily waters of the Ash. It is a city that belongs to the dead and those who speak to them."
    }
  },
  {
    "id": "shadow_lands",
    "name": "The Shadow Lands",
    "type": "landmark",
    "continent": "essos",
    "region": "far_lands",
    "canon_status": "unknown",
    "source": "https://awoiaf.westeros.org/index.php/Shadow_Lands",
    "tags": [
      "landmark",
      "mountain",
      "magic",
      "unknown_zone"
    ],
    "ownership_history": [],
    "metadata": {
      "type": "landmark",
      "description": "A mountainous, dark region beyond Asshai. It is believed to be the home of shadowbinders, demons, and ghost grass. Westerosi maesters have never mapped its interior.",
      "narratorText": "The Shadow Lands are a realm of perpetual twilight, choked by ghost grass that glows with a pale light and kills all other plants. It is said that dragons first came from the Shadow, hatched from a moon that cracked, and that they will one day return."
    }
  },
