      "prehistoric",
      "sothoryos"
    ],
    "ownership_history": [
      {
        "year": -10000,
        "house": null,
        "faction": "unknown_builders",
        "lord": "Unknown prehistoric entity",
        "status": "ruined",
        "event": "A city built of massive blocks of oily black stone, older than history. The Rhoynar under Princess Nymeria attempted to settle here, but every settler mysteriously vanished in a single night.",
        "canon": "unknown",
        "source": "https://awoiaf.westeros.org/index.php/Yeen"
      }
    ],
    "metadata": {
      "type": "city",
      "description": "An ancient, prehistoric city built of massive blocks of oily black stone that seems to swallow light. Described in legends as a place of horror where nothing grows and no birds sing.",
      "narratorText": "Even the jungle will not touch Yeen. Built of black stone that remains dry in the wettest monsoon, its origin is forgotten. Princess Nymeria left a colony of Rhoynar here; when she returned, she found only empty streets. The city had devoured them."
    }
  },
  {
    "id": "gogossos",
    "name": "Gogossos",
    "type": "city",
