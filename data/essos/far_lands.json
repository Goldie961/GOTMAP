    ],
    "ownership_history": [
      {
        "year": -500,
        "house": null,
        "faction": "valyrian_freehold",
        "lord": "Valyrian Governor",
        "status": "intact",
        "event": "Founded by the Valyrian Freehold as a penal colony named Gorgai. It became a center of horrific blood magic, flesh-shaping, and beast-breeding experiments.",
        "canon": "inferred",
        "source": "https://awoiaf.westeros.org/index.php/Gogossos"
      },
      {
        "year": -102,
        "house": null,
        "faction": "corsairs",
        "lord": "Corsair Kings",
        "status": "intact",
        "event": "Following the Doom of Valyria, the prisoners and guards seize control, renaming the city Gogossos. It becomes a wealthy, brutal slave port known as the Tenth Free City.",
        "canon": "inferred",
        "source": "https://awoiaf.westeros.org/index.php/Gogossos"
      },
      {
        "year": -25,
        "house": null,
        "faction": "red_death",
        "lord": "None",
        "status": "ruined",
        "event": "The Red Death — a catastrophic hemorrhagic plague — sweeps out of the slave pens of Gogossos. It wipes out 90% of the population, leaving the city a silent, cursed graveyard.",
        "canon": "inferred",
        "source": "https://awoiaf.westeros.org/index.php/Gogossos"
      }
    ],
    "metadata": {
      "type": "city",
      "description": "Originally Gorgai under Valyria, this penal colony became Gogossos. It was notorious for flesh-shaping magic and beast-hybrid breeding. The city was completely depopulated by the horrific Red Death plague.",
      "narratorText": "Gogossos is a cursed name. Here, Valyrian sorcerers mated human slave women with beasts to shape chimeras. When the Red Death came, the screams of the dying could be heard across the seas. Now, only basilisks crawl through its black slave pits."
    }
  },
