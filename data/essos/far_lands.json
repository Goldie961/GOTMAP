    ],
    "ownership_history": [
      {
        "year": -3000,
        "house": null,
        "faction": "ghiscari_empire",
        "lord": "Unknown Ghiscari Governor",
        "status": "ruined",
        "event": "Established by the Old Ghiscari Empire at the mouth of the Zamoyos. It is the only colony that lasted more than a generation before being consumed by plague and reclaimed by the jungle.",
        "canon": "inferred",
        "source": "https://awoiaf.westeros.org/index.php/Zamettar"
      }
    ],
    "metadata": {
      "type": "city",
      "description": "A grand walled city established by the Old Ghiscari Empire. Once a thriving trading port at the mouth of the Zamoyos, it was abandoned to the jungle and is now a haunted ruin of crumbling stone.",
      "narratorText": "Zamettar once flew the banners of the Harpy of Ghis, but the jungle always reclaims its own. Its walls are now choked with vines, and its harbor lies empty, a monument to the folly of men who tried to tame Sothoryos."
    }
  },
  {
    "id": "yeen",
